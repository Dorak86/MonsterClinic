{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spezies",
  "type": "object",
  "required": [
    "id",
    "formatVersion",
    "sizeClass",
    "activity",
    "needs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^species\\.[a-z0-9_]+$"
    },
    "formatVersion": {
      "const": 1
    },
    "placeholder": {
      "type": "boolean"
    },
    "_note": {
      "type": "string",
      "description": "Freier Kommentar fuer Autoren, wird vom Spiel ignoriert"
    },
    "sizeClass": {
      "enum": [
        "1x1",
        "2x2"
      ]
    },
    "activity": {
      "enum": [
        "night",
        "day"
      ],
      "description": "Kreatur der Nacht oder des Tages (D-05)"
    },
    "needs": {
      "type": "array",
      "items": {
        "enum": [
          "darkness",
          "blood_supply",
          "cooling",
          "hygiene",
          "spare_parts",
          "magic_stability",
          "material_anchoring",
          "robust_equipment",
          "heat_resistance",
          "large_space"
        ]
      }
    },
    "groupSizeMin": {
      "type": "integer",
      "minimum": 1,
      "description": "Kleinste Gruppengroesse bei Ankunft (A-12: Goblins ab 3)"
    },
    "behaviors": {
      "type": "array",
      "items": {
        "enum": [
          "shake_vending_machine",
          "pee_on_plants"
        ]
      },
      "description": "Stoerverhalten in der Klinik (A-12)"
    },
    "annoyedBy": {
      "type": "array",
      "items": {
        "enum": [
          "shake_vending_machine",
          "pee_on_plants"
        ]
      },
      "description": "Verhalten anderer, das diese Spezies nervt (A-12)"
    }
  },
  "additionalProperties": false,
  "x-locKeys": [
    "name"
  ]
}
